rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(professionalIdField) {
      return resource.data[professionalIdField] == request.auth.uid;
    }

    function isCreatingAsOwner(professionalIdField) {
      return request.resource.data[professionalIdField] == request.auth.uid;
    }

    // hasRole() consulta o documento do usuário para verificar a role.
    // ATIVAÇÃO: requer que o campo `role` esteja presente em /users/{uid}.
    // Valores válidos: "medico" | "farmaceutico" | "admin" | "recepcionista"
    // Enquanto o sistema de roles não for semeado, use isAuthenticated() + isolamento por uid.
    function hasRole(role) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function hasFinancialWriteAccess() {
      return isAuthenticated() && (
        hasRole("medico") || hasRole("farmaceutico") || hasRole("admin")
      );
    }

    // ── Perfil do usuário ────────────────────────────────────────
    // Cada usuário só acessa o próprio documento. `role` só é atribuído
    // server-side (Cloud Functions com Admin SDK, que ignora estas regras) —
    // o cliente nunca pode criar, alterar OU remover esse campo.
    //
    // NOTA: comparar por igualdade (não por presença da chave) é proposital.
    // `request.resource.data` reflete o documento resultante inteiro numa
    // atualização, então checar apenas `!("role" in request.resource.data)`
    // (a) bloquearia qualquer escrita futura não relacionada assim que uma
    // role existisse (o campo antigo sempre "reaparece" no resultado) e (b)
    // permitiria o próprio cliente apagar sua role com
    // `updateDoc(..., { role: deleteField() })`, já que a chave deixa de
    // existir no resultado — driblando a proteção de "último admin" que só
    // existe dentro da Cloud Function setUserRole. Exigir que a role
    // resultante seja igual à role atual (presente ou ausente) impede as
    // duas coisas.
    function roleUnchanged() {
      return request.resource.data.get('role', null) == resource.data.get('role', null);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId
        && !("role" in request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid == userId && roleUnchanged();
      // Sem delete: o documento carrega o campo role usado para contagem de
      // admins (setUserRole) e para auditoria. Apagar o próprio perfil não
      // deve ser um caminho para sair dessa contabilização.
      allow delete: if false;
    }

    // ── Configurações da clínica ─────────────────────────────────
    // clinic_settings/whatsapp guarda o token da API Z-API — segredo real,
    // não dado de exibição. Um único match com condição por docId (em vez de
    // dois match blocks para o mesmo caminho) porque no Firestore, quando
    // mais de um match block cobre o mesmo documento, o acesso é liberado se
    // QUALQUER UM permitir (união/OR) — um bloco "admin-only" para
    // "whatsapp" ao lado de um bloco geral "isAuthenticated()" para
    // "{docId}" NÃO restringiria nada, já que o segundo também bateria e
    // seria OR'd com o primeiro.
    match /clinic_settings/{docId} {
      allow read: if docId == "whatsapp" ? hasRole("admin") : isAuthenticated();
      allow write: if hasRole("admin");
    }

    // ── Profissionais ────────────────────────────────────────────
    // Cadastro institucional da clínica (não são contas de login — ver
    // /users para isso). Leitura para todos autenticados; escrita restrita a
    // admin. NOTA: os documentos usam ID auto-gerado (addDoc), então uma
    // checagem "request.auth.uid == docId" nunca seria verdadeira — por
    // isso a gestão é centralizada em admin em vez de tentar simular dono.
    match /professionals/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasRole("admin");
    }

    // ── Pacientes ────────────────────────────────────────────────
    // Isolamento total por professionalId
    match /patients/{patientId} {
      allow read: if isAuthenticated() && isOwner("professionalId");
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated()
        && isOwner("professionalId")
        && isCreatingAsOwner("professionalId");
      allow delete: if isAuthenticated() && isOwner("professionalId");
    }

    // ── Agendamentos ─────────────────────────────────────────────
    // Isolamento total por professionalId (mesmo padrão de /patients)
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && isOwner("professionalId");
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated()
        && isOwner("professionalId")
        && isCreatingAsOwner("professionalId");
      allow delete: if isAuthenticated() && isOwner("professionalId");
    }

    // ── Registros clínicos ───────────────────────────────────────
    // Leitura: profissional autenticado que criou o registro OU que é dono do paciente.
    // O acesso ao patientId já é controlado pelas regras de /patients.
    // Escrita: apenas o profissional dono do registro.
    // Deleção: nunca — registros clínicos são imutáveis por LGPD/auditoria.

    match /consultations/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated() && isOwner("professionalId");
      allow delete: if false;
    }

    match /prescriptions/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated() && isOwner("professionalId");
      allow delete: if false;
    }

    match /evolutions/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated() && isOwner("professionalId");
      allow delete: if false;
    }

    match /exams/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated() && isOwner("professionalId");
      allow delete: if isAuthenticated() && isOwner("professionalId");
    }

    match /protocols/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.professionalId == request.auth.uid
            || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isCreatingAsOwner("professionalId");
      allow update: if isAuthenticated() && isOwner("professionalId");
      allow delete: if false;
    }

    // ── Transações financeiras ───────────────────────────────────
    // Leitura: isolada por uid (cada profissional vê apenas seus próprios lançamentos).
    // Escrita: requer role clínica (médico/farmacêutico/admin) OU ser o criador do registro.
    // NOTA: enquanto roles não forem semeados nos documentos /users/{uid},
    //       a criação via batch da anamnese passa pela verificação de createdByUid.
    match /transactions/{docId} {
      allow read: if isAuthenticated() && resource.data.createdByUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.createdByUid == request.auth.uid;
      allow delete: if false; // Registros financeiros são imutáveis (compliance)
    }

    // ── Coleção financeira avançada (futura expansão) ─────────────
    // Reservado para quando o módulo financeiro evoluir para faturamento
    // por empresa (PJ) com múltiplos profissionais por conta.
    // Requer que /users/{uid}.role esteja semeado para ativar hasFinancialWriteAccess().
    match /financeiro/{docId} {
      allow read: if isAuthenticated() && resource.data.createdByUid == request.auth.uid;
      allow create: if hasFinancialWriteAccess()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if hasFinancialWriteAccess()
        && resource.data.createdByUid == request.auth.uid;
      allow delete: if false;
    }

    // ── Log de Auditoria (LGPD) ──────────────────────────────────
    // Apenas criação permitida; ninguém pode apagar ou alterar logs.
    // Leitura: o próprio autor vê sua trilha, admin vê a trilha completa
    // (a página /privacy existe para monitoramento de conformidade da
    // clínica como um todo, não só da própria atividade).
    match /audit_logs/{docId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
            || resource.data.professionalId == request.auth.uid
            || hasRole("admin"));
      // userId precisa ser o autor real da requisição — sem isso, qualquer
      // autenticado poderia forjar uma entrada atribuindo uma ação a outro
      // usuário, quebrando a garantia de não-repúdio que esse log existe
      // para sustentar.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Logs são permanentes e imutáveis
    }

  }
}
