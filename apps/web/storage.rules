rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Exames de pacientes — apenas o profissional dono do paciente (isolamento LGPD)
    match /patients/{patientId}/exams/{fileName} {
      allow read, write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/patients/$(patientId)).data.professionalId == request.auth.uid;
    }
    // Logos e assets da clínica
    match /clinic/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Bloquear todo o resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
